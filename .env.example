# Copy to .env and adjust. Every value here is required by docker-compose.yml.
MIHOMO_TAG=latest
HOST_MIXED_PORT=7890
HOST_CONTROLLER_PORT=9090
TEST_GROUP=TEST_POOL
PRODUCTION_GROUP=POOL
PROVIDER_NAMES=free-vless
HEALTH_URL=https://www.gstatic.com/generate_204
HEALTH_INTERVAL_S=10
HEALTH_TIMEOUT_MS=3000
MAX_DELAY_MS=800
PROBE_BATCH_SIZE=100
PROBE_WORKERS=100
MAX_PROBE_BATCHES=3
FAILOVER_GOOD_CANDIDATES=1
SWEEP_GOOD_CANDIDATES=5
TEST_URL=https://speed.cloudflare.com/__down?bytes=5000000
TEST_INTERVAL_S=300
TEST_TIMEOUT_S=15
TEST_MAX_BYTES=8388608
TEST_MAX_NODES=5
HISTORY_COOLDOWN_FAILS=3
HISTORY_COOLDOWN_H=1
HISTORY_WINDOW_H=24
# Hash-gate ports (username = node hash, password = TTL seconds). Defaults apply
# when unset; set them here only to move the ports.
HASH_GATE_ALL_PORT=17894
HASH_GATE_FREE_PORT=17895
HASH_GATE_CUSTOM_PORT=17896
# Management REST API. Localhost only; every endpoint needs this bearer token.
# Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=change-me-to-a-generated-token
API_PORT=18080
